    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Audio d0wnloader for ev3rything.</description>
    <tags>r1pper cli rust</tags>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>